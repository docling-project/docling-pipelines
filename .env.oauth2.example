# OAuth2 and OIDC Configuration Example
# Copy this file to .env and configure your OAuth2 settings

# ============================================================================
# JWT Configuration (Required for all auth methods)
# ============================================================================
# Required when DOCPIPE_AUTH_ENABLED=true: at least 32 characters, not a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# OAuth2 General Settings
# ============================================================================
OAUTH2_ENABLED=true
OAUTH2_PROVIDER=google  # Options: google, azure, generic
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
# Port 8080 is the FastAPI port. Use http://localhost:3000/... only with the Vite dev server,
# and https://<your-domain>/... behind a TLS ingress.
OAUTH2_REDIRECT_URI=http://localhost:8080/auth/oauth2/callback
OAUTH2_SCOPE=openid profile email
OAUTH2_TOKEN_VALIDATION=true
OAUTH2_STATE_SECRET=your-state-secret-here
OAUTH2_SESSION_EXPIRE_MINUTES=60

# ============================================================================
# Google OAuth2 Configuration
# ============================================================================
# When using OAUTH2_PROVIDER=google, these are auto-configured:
# OAUTH2_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# OAUTH2_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
# OAUTH2_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
# OAUTH2_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
# OAUTH2_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
# OIDC_ISSUER=https://accounts.google.com
# OIDC_AUDIENCE=your-client-id

# Google OAuth2 Setup:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Go to Credentials > Create Credentials > OAuth 2.0 Client ID
# 5. Set application type to "Web application"
# 6. Add authorized redirect URI: http://localhost:8080/auth/oauth2/callback
# 7. Copy Client ID and Client Secret to OAUTH2_CLIENT_ID and OAUTH2_CLIENT_SECRET

# ============================================================================
# Azure AD OAuth2 Configuration
# ============================================================================
# When using OAUTH2_PROVIDER=azure, configure:
AZURE_TENANT_ID=common  # Or your specific tenant ID

# Azure AD Setup:
# 1. Go to https://portal.azure.com/
# 2. Navigate to Azure Active Directory > App registrations
# 3. Click "New registration"
# 4. Set redirect URI: http://localhost:8080/auth/oauth2/callback
# 5. Go to Certificates & secrets > New client secret
# 6. Copy Application (client) ID to OAUTH2_CLIENT_ID
# 7. Copy client secret value to OAUTH2_CLIENT_SECRET
# 8. Copy Directory (tenant) ID to AZURE_TENANT_ID

# ============================================================================
# Generic OIDC Provider Configuration
# ============================================================================
# When using OAUTH2_PROVIDER=generic, manually configure all endpoints:
# OAUTH2_DISCOVERY_URL=https://your-provider.com/.well-known/openid-configuration
# OAUTH2_AUTHORIZATION_ENDPOINT=https://your-provider.com/oauth2/authorize
# OAUTH2_TOKEN_ENDPOINT=https://your-provider.com/oauth2/token
# OAUTH2_USERINFO_ENDPOINT=https://your-provider.com/oauth2/userinfo
# OAUTH2_JWKS_URI=https://your-provider.com/oauth2/jwks
# OIDC_ISSUER=https://your-provider.com
# OIDC_AUDIENCE=your-client-id

# Generic OIDC providers include:
# - Okta: https://your-domain.okta.com/.well-known/openid-configuration
# - Auth0: https://your-domain.auth0.com/.well-known/openid-configuration
# - Keycloak: https://your-domain.com/auth/realms/{realm}/.well-known/openid-configuration
# - GitLab: https://gitlab.com/.well-known/openid-configuration

# ============================================================================
# LDAP Configuration (Optional - for LDAP authentication)
# ============================================================================
LDAP_SERVER=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN=ou=users,dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=<your-ldap-bind-password>
LDAP_USE_SSL=false
LDAP_USE_ACTIVE_DIRECTORY=false
LDAP_AD_DOMAIN=example.com

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# Usage Examples
# ============================================================================

# Example 1: Google OAuth2
# OAUTH2_ENABLED=true
# OAUTH2_PROVIDER=google
# OAUTH2_CLIENT_ID=123456789-abcdefg.apps.googleusercontent.com
# OAUTH2_CLIENT_SECRET=GOCSPX-your-secret-here
# OAUTH2_REDIRECT_URI=http://localhost:8080/auth/oauth2/callback

# Example 2: Azure AD OAuth2
# OAUTH2_ENABLED=true
# OAUTH2_PROVIDER=azure
# AZURE_TENANT_ID=your-tenant-id-here
# OAUTH2_CLIENT_ID=your-application-id-here
# OAUTH2_CLIENT_SECRET=your-client-secret-here
# OAUTH2_REDIRECT_URI=http://localhost:8080/auth/oauth2/callback

# Example 3: Okta OIDC
# OAUTH2_ENABLED=true
# OAUTH2_PROVIDER=generic
# OAUTH2_DISCOVERY_URL=https://your-domain.okta.com/.well-known/openid-configuration
# OAUTH2_CLIENT_ID=your-okta-client-id
# OAUTH2_CLIENT_SECRET=your-okta-client-secret
# OAUTH2_REDIRECT_URI=http://localhost:8080/auth/oauth2/callback
# OIDC_ISSUER=https://your-domain.okta.com
# OIDC_AUDIENCE=your-okta-client-id
