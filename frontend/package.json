{
  "name": "docpipe-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:bff\" \"npm:dev:vite\" --names \"BFF,VITE\" --prefix-colors \"blue,green\"",
    "dev:vite": "vite",
    "dev:bff": "NODE_ENV=development tsx server/server.ts",
    "build": "vite build",
    "build:bff": "esbuild server/server.ts --bundle --platform=node --format=cjs --outfile=bff/server.cjs",
    "start": "NODE_ENV=production npm run build && tsx server/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "extract:messages": "formatjs extract 'src/**/*.{ts,tsx}' --ignore='**/*.d.ts' --out-file src/i18n/messages_en.json --format simple",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage"
  },
  "dependencies": {
    "@carbon-labs/react-animated-header": "^0.54.0",
    "@carbon-labs/utilities": "^0.28.0",
    "@carbon/charts-react": "^1.19.3",
    "@carbon/colors": "^11.30.0",
    "@carbon/ibm-products": "^2.53.0",
    "@carbon/icons-react": "^11.52.0",
    "@carbon/react": "^1.68.2",
    "@carbon/styles": "^1.109.0",
    "@elyra/canvas": "^13.51.1",
    "@reduxjs/toolkit": "^2.5.0",
    "axios": "^1.18.0",
    "concurrently": "^8.2.2",
    "dotenv": "^18.0.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@formatjs/cli": "^6.16.31",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-formatjs": "^8.0.5",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "sass": "^1.83.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "linkify-it": "^5.0.2",
    "immutable": ">=5.1.8",
    "dompurify": ">=3.4.13",
    "qs": ">=6.17.0",
    "handlebars": "^4.7.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --cache --fix"
  }
}
