<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Page Not Found :: {{site.title}}</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%2333b1ff'/><text x='16' y='22' font-family='IBM Plex Sans,system-ui,sans-serif' font-size='14' font-weight='700' fill='%230f1117' text-anchor='middle'>DP</text></svg>">
  <style>
/* ============================================================
   Docling-pipelines Documentation — Custom Antora UI Theme
   Inspired by IBM technical book aesthetic (dark navy + cyan)
   ============================================================ */

/* ── Fonts ── */
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap');

/* ── CSS Variables ── */
:root {
  --color-bg:          #0f1117;
  --color-bg-alt:      #161b27;
  --color-bg-card:     #1a2035;
  --color-surface:     #1e2740;
  --color-border:      #2a3550;
  --color-accent:      #33b1ff;
  --color-accent-dim:  #1a6ea0;
  --color-accent-glow: rgba(51,177,255,.15);
  --color-text:        #d4dbe8;
  --color-text-dim:    #8898aa;
  --color-text-head:   #ffffff;
  --color-code-bg:     #111827;
  --color-code-text:   #e2e8f0;
  --color-warn:        #f59e0b;
  --color-note:        #33b1ff;
  --color-tip:         #34d399;
  --color-caution:     #f87171;
  --nav-width:         280px;
  --header-height:     60px;
  --font-body:         'IBM Plex Sans', system-ui, sans-serif;
  --font-mono:         'IBM Plex Mono', 'Courier New', monospace;
  --radius:            6px;
  --shadow:            0 4px 24px rgba(0,0,0,.45);
}

/* ── Reset / Base ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { font-size: 16px; scroll-behavior: smooth; }

body {
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  font-weight: 400;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

/* ── Layout shell ── */
.site-wrapper {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.site-body {
  display: flex;
  flex: 1;
  padding-top: var(--header-height);
}

/* ── Top header ── */
.site-header {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: var(--header-height);
  background: var(--color-bg-alt);
  border-bottom: 1px solid var(--color-border);
  display: flex;
  align-items: center;
  padding: 0 24px;
  z-index: 200;
  gap: 16px;
}

.site-header .logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
}

.site-header .logo-mark {
  width: 32px; height: 32px;
  background: var(--color-accent);
  border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700;
  font-size: 14px;
  color: var(--color-bg);
  letter-spacing: -.5px;
  flex-shrink: 0;
}

.site-header .logo-text {
  font-size: 17px;
  font-weight: 700;
  color: var(--color-text-head);
  letter-spacing: -.3px;
}

.site-header .logo-subtitle {
  font-size: 11px;
  color: var(--color-text-dim);
  font-weight: 400;
  letter-spacing: .5px;
  text-transform: uppercase;
}

.site-header .header-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12px;
}

.site-header .version-badge {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  color: var(--color-accent);
  font-family: var(--font-mono);
  font-size: 11px;
  padding: 3px 10px;
  border-radius: 20px;
  letter-spacing: .5px;
}

/* ── Sidebar navigation ── */
.nav-sidebar {
  width: var(--nav-width);
  flex-shrink: 0;
  background: var(--color-bg-alt);
  border-right: 1px solid var(--color-border);
  overflow-y: auto;
  height: calc(100vh - var(--header-height));
  position: sticky;
  top: var(--header-height);
  padding: 24px 0 40px;
}

.nav-sidebar::-webkit-scrollbar { width: 5px; }
.nav-sidebar::-webkit-scrollbar-track { background: transparent; }
.nav-sidebar::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 3px; }

.nav-list { list-style: none; }

.nav-list .nav-item > .nav-link {
  display: block;
  padding: 7px 24px;
  color: var(--color-text-dim);
  font-size: 13px;
  font-weight: 500;
  text-decoration: none;
  letter-spacing: .1px;
  transition: color .15s, background .15s;
  border-left: 3px solid transparent;
}

.nav-list .nav-item > .nav-link:hover {
  color: var(--color-text);
  background: var(--color-bg-card);
}

.nav-list .nav-item.is-current-page > .nav-link,
.nav-list .nav-item.is-current-page > .nav-link:hover {
  color: var(--color-accent);
  border-left-color: var(--color-accent);
  background: var(--color-accent-glow);
  font-weight: 600;
}

/* nested nav items */
.nav-list .nav-list .nav-item > .nav-link {
  padding-left: 40px;
  font-size: 12.5px;
}

.nav-title {
  display: block;
  padding: 6px 24px 4px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--color-text-dim);
  margin-top: 16px;
}

/* ── Main content area ── */
.main-content {
  flex: 1;
  min-width: 0;
  padding: 48px 64px;
  max-width: 880px;
}

/* ── Article / page content ── */
.doc {
  max-width: 780px;
}

/* ── Headings ── */
h1, h2, h3, h4, h5, h6 {
  color: var(--color-text-head);
  font-weight: 700;
  line-height: 1.25;
  margin: 2em 0 .6em;
}

h1 { font-size: 2.2rem; margin-top: 0; border-bottom: 1px solid var(--color-border); padding-bottom: .5em; }
h2 { font-size: 1.6rem; border-bottom: 1px solid var(--color-border); padding-bottom: .3em; }
h3 { font-size: 1.2rem; }
h4 { font-size: 1rem; }

/* Chapter number decoration */
.sect1 > h2::before {
  content: attr(data-sectnum);
  display: none;
}

/* ── Paragraph ── */
p { margin: 0 0 1em; }

/* ── Links ── */
a { color: var(--color-accent); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ── Code blocks ── */
pre {
  background: var(--color-code-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 20px 24px;
  overflow-x: auto;
  margin: 1.25em 0;
  position: relative;
}

pre code {
  font-family: var(--font-mono);
  font-size: .875rem;
  color: var(--color-code-text);
  background: none;
  padding: 0;
  border: none;
}

code {
  font-family: var(--font-mono);
  font-size: .875em;
  background: var(--color-code-bg);
  color: var(--color-accent);
  padding: 2px 6px;
  border-radius: 4px;
  border: 1px solid var(--color-border);
}

/* Syntax highlight colours (highlight.js dark) */
.hljs-keyword, .hljs-selector-tag  { color: #c678dd; }
.hljs-string, .hljs-attr           { color: #98c379; }
.hljs-number                       { color: #d19a66; }
.hljs-comment                      { color: #5c6370; font-style: italic; }
.hljs-variable, .hljs-template-variable { color: #e06c75; }
.hljs-built_in, .hljs-type         { color: #61afef; }
.hljs-literal                      { color: #56b6c2; }
.hljs-title.function_              { color: #61afef; }
.hljs-meta                         { color: #f59e0b; }

/* ── Admonition blocks ── */
.admonitionblock {
  border-radius: var(--radius);
  padding: 16px 20px;
  margin: 1.5em 0;
  display: flex;
  gap: 16px;
  border-left: 4px solid;
}

.admonitionblock td.icon { flex-shrink: 0; min-width: 24px; }
.admonitionblock td.icon .title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.admonitionblock td.content { flex: 1; }
.admonitionblock td.content p { margin: 0; font-size: .9rem; }

.admonitionblock.note   { background: rgba(51,177,255,.08); border-color: var(--color-note); }
.admonitionblock.tip    { background: rgba(52,211,153,.08); border-color: var(--color-tip); }
.admonitionblock.caution{ background: rgba(248,113,113,.08); border-color: var(--color-caution); }
.admonitionblock.warning{ background: rgba(245,158,11,.08);  border-color: var(--color-warn); }
.admonitionblock.important { background: rgba(196,141,255,.08); border-color: #c48dff; }

.admonitionblock.note    .title { color: var(--color-note); }
.admonitionblock.tip     .title { color: var(--color-tip); }
.admonitionblock.caution .title { color: var(--color-caution); }
.admonitionblock.warning .title { color: var(--color-warn); }
.admonitionblock.important .title { color: #c48dff; }

/* ── Tables ── */
table.tableblock {
  width: 100%;
  border-collapse: collapse;
  margin: 1.5em 0;
  font-size: .9rem;
}

table.tableblock th {
  background: var(--color-surface);
  color: var(--color-text-head);
  font-weight: 600;
  padding: 10px 16px;
  text-align: left;
  border: 1px solid var(--color-border);
  letter-spacing: .3px;
  font-size: .8rem;
  text-transform: uppercase;
}

table.tableblock td {
  padding: 9px 16px;
  border: 1px solid var(--color-border);
  vertical-align: top;
}

table.tableblock tr:nth-child(even) td {
  background: var(--color-bg-card);
}

table.tableblock tr:hover td {
  background: var(--color-surface);
}

/* ── Lists ── */
ul, ol { padding-left: 1.5em; margin: 0 0 1em; }
li { margin: .3em 0; }

/* ── Definition lists ── */
dl dt { font-weight: 600; color: var(--color-text-head); margin-top: .75em; }
dl dd { margin-left: 1.5em; color: var(--color-text-dim); }

/* ── Horizontal rule ── */
hr { border: none; border-top: 1px solid var(--color-border); margin: 2em 0; }

/* ── Breadcrumbs ── */
.breadcrumbs {
  font-size: 12px;
  color: var(--color-text-dim);
  margin-bottom: 28px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.breadcrumbs a { color: var(--color-text-dim); }
.breadcrumbs a:hover { color: var(--color-accent); }
.breadcrumbs .separator { color: var(--color-border); }
.breadcrumbs .current { color: var(--color-text); }

/* ── Page navigation (prev / next) ── */
.page-nav {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 64px;
  padding-top: 24px;
  border-top: 1px solid var(--color-border);
}

.page-nav a {
  display: flex;
  flex-direction: column;
  padding: 16px 20px;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  text-decoration: none;
  min-width: 0;
  flex: 1;
  max-width: 48%;
  transition: border-color .15s, background .15s;
}

.page-nav a:hover {
  border-color: var(--color-accent);
  background: var(--color-accent-glow);
}

.page-nav .nav-dir {
  font-size: 11px;
  color: var(--color-text-dim);
  text-transform: uppercase;
  letter-spacing: .8px;
  font-weight: 600;
  margin-bottom: 4px;
}

.page-nav .nav-title {
  font-size: 14px;
  color: var(--color-text-head);
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.page-nav .next { text-align: right; margin-left: auto; }

/* ── Footer ── */
.site-footer {
  background: var(--color-bg-alt);
  border-top: 1px solid var(--color-border);
  padding: 16px 24px;
  font-size: 12px;
  color: var(--color-text-dim);
  display: flex;
  align-items: center;
  gap: 16px;
}

.site-footer a { color: var(--color-text-dim); }
.site-footer a:hover { color: var(--color-accent); }

/* ── TOC (right sidebar) ── */
.toc-nav {
  width: 220px;
  flex-shrink: 0;
  position: sticky;
  top: calc(var(--header-height) + 48px);
  align-self: flex-start;
  max-height: calc(100vh - var(--header-height) - 80px);
  overflow-y: auto;
  padding: 0 16px;
  font-size: 12px;
}

.toc-nav::-webkit-scrollbar { width: 3px; }
.toc-nav::-webkit-scrollbar-thumb { background: var(--color-border); }

.toc-nav .toc-title {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--color-text-dim);
  margin-bottom: 12px;
}

.toc-nav a {
  display: block;
  color: var(--color-text-dim);
  padding: 4px 0 4px 8px;
  border-left: 2px solid transparent;
  line-height: 1.4;
  transition: color .15s;
}

.toc-nav a:hover, .toc-nav a.is-active {
  color: var(--color-accent);
  border-left-color: var(--color-accent);
}

/* ── Hero (index page) ── */
.hero {
  background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-bg-card) 100%);
  border: 1px solid var(--color-border);
  border-radius: 12px;
  padding: 48px 48px;
  margin-bottom: 48px;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -40px; right: -40px;
  width: 300px; height: 300px;
  background: radial-gradient(circle, var(--color-accent-glow) 0%, transparent 70%);
  pointer-events: none;
}

.hero h1 {
  border: none;
  padding: 0;
  font-size: 2.6rem;
  background: linear-gradient(135deg, #ffffff 0%, var(--color-accent) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: .4em;
}

.hero .hero-sub {
  font-size: 1.1rem;
  color: var(--color-text-dim);
  max-width: 600px;
  line-height: 1.6;
}

/* ── Chip / badge ── */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 11px;
  font-weight: 600;
  color: var(--color-text-dim);
  letter-spacing: .4px;
  text-transform: uppercase;
  margin: 0 4px 8px 0;
}

.chip.accent { background: var(--color-accent-glow); border-color: var(--color-accent-dim); color: var(--color-accent); }

/* ── Responsive ── */
@media (max-width: 1280px) {
  .toc-nav { display: none; }
  .main-content { padding: 40px 48px; }
}

@media (max-width: 900px) {
  .nav-sidebar { display: none; }
  .main-content { padding: 32px 24px; }
}

@media (max-width: 600px) {
  h1 { font-size: 1.7rem; }
  h2 { font-size: 1.3rem; }
  .hero { padding: 32px 24px; }
  .hero h1 { font-size: 2rem; }
}

/* ── Copy button (injected by JS) ── */
.copy-btn {
  position: absolute;
  top: 10px; right: 12px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 4px;
  color: var(--color-text-dim);
  cursor: pointer;
  padding: 4px 6px;
  display: flex; align-items: center; justify-content: center;
  opacity: 0;
  transition: opacity .2s, color .15s;
}
pre:hover .copy-btn { opacity: 1; }
.copy-btn:hover { color: var(--color-accent); border-color: var(--color-accent-dim); }

  </style>
</head>
<body>
  <div class="site-wrapper">
    {{> header}}
    <div class="site-body">
      <main class="main-content" id="main-content">
        <article class="doc">
          <h1>Page Not Found</h1>
          <p>The page you requested could not be found.</p>
          <p><a href="{{siteRootPath}}/index.html">Return to home</a></p>
        </article>
      </main>
    </div>
    {{> footer}}
  </div>
</body>
</html>
