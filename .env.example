# OpenSearch Connection Configuration
# Copy this file to .env and update with your actual values
# ============================================================================
# PYTHON PATH CONFIGURATION
# ============================================================================
# Required for imports to work correctly
# This should be set relative to the project root
PYTHONPATH=./src


# ============================================================================
# LOCAL DOCKER SETUP (using docker-compose.opensearch.yml)
# ============================================================================
# To run OpenSearch locally with Docker:
#   docker-compose -f docker-compose.opensearch.yml up -d
#
# Use these settings for local Docker instance:
# OPENSEARCH_HOST=localhost
# OPENSEARCH_PORT=9200
# OPENSEARCH_USE_SSL=false
# OPENSEARCH_VERIFY_CERTS=false
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=<your-opensearch-password>
#
# OpenSearch Dashboards will be available at: http://localhost:5601
# ============================================================================

# OpenSearch Server
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# Authentication
OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=<set-your-password>

# AWS Authentication (optional, set to true if using AWS OpenSearch)
OPENSEARCH_AWS_AUTH=false
# JWT Authentication (optional, for AWS OpenSearch with JWT tokens)
# OPENSEARCH_JWT_TOKEN=your-jwt-token-here
OPENSEARCH_AWS_REGION=us-east-1

# Engine Configuration
OPENSEARCH_ENGINE=faiss
OPENSEARCH_ALGORITHM=hnsw
OPENSEARCH_SPACE_TYPE=l2
OPENSEARCH_VECTOR_DIMENSION=384

# Performance Settings
OPENSEARCH_BATCH_SIZE=100

# Index Configuration
OPENSEARCH_INDEX_NAME=docpipe_test
OPENSEARCH_DOC_ID_COLUMN=doc_id_hash
OPENSEARCH_EMBEDDINGS_COLUMN=embeddings

# Document Retrieval API Configuration
# Default index for document retrieval endpoints
OPENSEARCH_DEFAULT_INDEX=documents
# Connection timeout in seconds
OPENSEARCH_TIMEOUT=30
# Maximum number of retry attempts
OPENSEARCH_MAX_RETRIES=3

DOCPIPE_INDEX=docpipe_test
DOCPIPE_MODEL=granite4:latest

# Ollama Configuration
# Ollama server host URL used by OllamaClient
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# ============================================================================
# VLM ENGINE CREDENTIALS (for ExtractOperator)
# ============================================================================
# These credentials are used by extract_operator_example.py for VLM engines
# that require API access (watsonx, openai, generic)

# Watsonx AI (IBM Cloud)
# Required for --vlm-engine watsonx
# WATSONX_API_KEY=your_ibm_cloud_api_key_here
# WATSONX_CONTAINER_KIND=project  # optional: project, space, or catalog (default: project)
# WATSONX_CONTAINER_ID=your_project_or_space_id_here
# WATSONX_MODEL=meta-llama/llama-3-2-90b-vision-instruct
# WATSONX_API_BASE_URL=https://us-south.ml.cloud.ibm.com  # optional, has default

# OpenAI API
# Required for --vlm-engine openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4-vision-preview
# OPENAI_API_BASE_URL=https://api.openai.com/v1  # optional, has default

# Generic API (any OpenAI-compatible API)
# Required for --vlm-engine generic
# GENERIC_API_BASE_URL=https://your-api.com/v1/chat
# GENERIC_API_KEY=your_api_key_here  # optional, some APIs don't require auth

# ============================================================================
# API AUTHENTICATION
# ============================================================================
# Secret key used to sign JWT access tokens.
# Must be at least 32 characters. Use a strong random value in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=local-dev-secret-key-change-this-in-production!!

# JWT algorithm (default: HS256)
# JWT_ALGORITHM=HS256

# Access token expiry in minutes (default: 30)
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins for CORS
# For development: http://localhost:3000 (frontend/UI server)
# For production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ============================================================================
# FLOW REPOSITORY CONFIGURATION
# ============================================================================
# Type of repository to use for storing flow definitions
# Options: local (default)
# If not set, defaults to 'local' repository type
# FLOW_REPOSITORY_TYPE=local

# Local repository settings (when FLOW_REPOSITORY_TYPE=local or not set)
# Directory where flow JSON files are stored
# If not set, defaults to:
#   macOS/Linux: ~/Documents/pipeline/assets
#   Windows: %USERPROFILE%\Documents\pipeline\assets
# Use absolute paths for production deployments

# ============================================================================
# TELEMETRY CONFIGURATION (Optional - OpenTelemetry)
# ============================================================================
# Enable/disable OpenTelemetry distributed tracing
# Set to true to enable telemetry, false to disable (default: false)
# When disabled, there is zero performance overhead
DOCLING_PIPELINES_TELEMETRY_ENABLED=false

# Service name that appears in traces
# This identifies your Docling Pipelines instance in the monitoring backend
OTEL_SERVICE_NAME=docling-pipelines

# OTLP endpoint for exporting traces
# Default points to local Jaeger instance
# For production, point to your OTLP collector or monitoring backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service version for trace metadata
OTEL_SERVICE_VERSION=0.1.0

# Deployment environment name (e.g., development, staging, production)
OTEL_DEPLOYMENT_ENVIRONMENT=development


# ============================================================================
# OPENLINEAGE CONFIGURATION (Optional - Data Lineage)
# ============================================================================
# Emit OpenLineage run events for flow runs. Disabled by default. Requires the
# lineage extra:
#   uv pip install -e ".[lineage]"
#
# IMPORTANT: the DOCPIPE_LINEAGE_* values are read when docpipe is imported,
# before this .env file is loaded. Set them with `export` in your shell (or in
# the process environment), not in .env. They are listed here for reference only.
#
# DOCPIPE_LINEAGE_ENABLED=false    # set to true to emit events
# DOCPIPE_LINEAGE_MODE=flow        # "flow" (one job per run) or "operator" (also one child run per DAG node)
# DOCPIPE_LINEAGE_NAMESPACE=docpipe://local
# DOCPIPE_LINEAGE_PRODUCER=https://github.com/docling-project/docling-pipelines
# DOCPIPE_LINEAGE_STRICT=false     # true: lineage errors halt the pipeline instead of being logged as warnings
#
# Transport is read by the OpenLineage SDK (console when unset), for example:
# OPENLINEAGE__TRANSPORT__TYPE=http
# OPENLINEAGE__TRANSPORT__URL=http://localhost:5000
#
# See docs/integrations/openlineage/OPENLINEAGE_GUIDE.md for details

# ============================================================================
# QUICK START WITH JAEGER (Local Development)
# ============================================================================
# To test telemetry locally with Jaeger:
#
# 1. Install telemetry dependencies:
#    uv pip install -e ".[telemetry]"
#
# 2. Start Jaeger (using Docker):
#    docker run -d --name jaeger \
#      -p 16686:16686 \
#      -p 4317:4317 \
#      -p 4318:4318 \
#      jaegertracing/all-in-one:latest
#
# 3. Enable telemetry:
#    DOCLING_PIPELINES_TELEMETRY_ENABLED=true
#    OTEL_SERVICE_NAME=docling-pipelines-dev
#    OTEL_SERVICE_VERSION=0.1.0
#    OTEL_DEPLOYMENT_ENVIRONMENT=Development
#
# 4. Run your flows normally - traces will appear in Jaeger UI
#    http://localhost:16686
#
# See docs/TELEMETRY_SETUP.md for detailed setup instructions
# ============================================================================
# LOCAL_FLOWS_DIR=/path/to/custom/flows/directory
