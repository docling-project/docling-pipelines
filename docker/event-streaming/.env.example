# Docling Pipelines application
OPENSEARCH_PASSWORD=MyStrongPass@123 # pragma: allowlist secret

# Set to true to start the Kafka listener; disabled by default
DOCPIPE_EVENT_STREAMING_ENABLED=true
DOCPIPE_API_BASE_URL=http://127.0.0.1:8080

# Kafka configurations
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_INPUT_TOPIC=docpipe-input

# Consumer configurations
KAFKA_GROUP_ID=docpipe-event-consumer

# Schema Registry configurations
SCHEMA_REGISTRY_URL=http://localhost:8081

# Authentication (on by default). Set DOCPIPE_AUTH_ENABLED=false only for a local, trusted setup.
# DOCPIPE_AUTH_ENABLED=true
# Required while authentication is on: at least 32 random characters, not a placeholder.
#   python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=<set-a-random-32-plus-character-value>
# Optional break-glass administrator. Generate the bcrypt hash as described in
# docs/guides/AUTHENTICATION_AND_AUTHORIZATION_GUIDE.md and wrap it in single quotes.
# DOCPIPE_AUTH_BOOTSTRAP_USERNAME=admin
# DOCPIPE_AUTH_BOOTSTRAP_PASSWORD_HASH='<bcrypt-hash>'
