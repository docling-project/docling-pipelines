# LDAP Server Configuration (local development only)
# docker-compose.yml reads these without defaults, so they must be set (copy this file to .env).
LDAP_ORGANIZATION=ABCInc
LDAP_DOMAIN=abc.com
LDAP_ADMIN_PASSWORD=${LDAP_ADMIN_PASSWORD}

# Test User Passwords (for development/testing only)
# In production, use proper password management
TEST_USER_PASSWORD=${TEST_USER_PASSWORD}
