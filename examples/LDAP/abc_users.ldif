# 1. Create the Organizational Unit for users
dn: ou=People,dc=abc,dc=com
objectClass: organizationalUnit
ou: People

# 2. Create test users for authentication and role testing
# The "ou" attribute of each user is the group value that Docling Pipelines maps to a role
# (LDAP_GROUP_ATTRIBUTE=ou): "editors" -> editor, "viewers" -> viewer.
# These are local development credentials only.

dn: cn=Alice Baker,ou=People,dc=abc,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
cn: Alice Baker
sn: Baker
givenName: Alice
ou: editors
uid: alice
# pragma: allowlist nextline secret
userPassword: Password123!
uidNumber: 1003
gidNumber: 1003
homeDirectory: /home/alice
mail: alice@abc.com

dn: cn=Charlie Brown,ou=People,dc=abc,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
cn: Charlie Brown
sn: Brown
givenName: Charlie
ou: viewers
uid: charlie
# pragma: allowlist nextline secret
userPassword: Password123!
uidNumber: 1002
gidNumber: 1002
homeDirectory: /home/charlie
mail: charlie@abc.com
