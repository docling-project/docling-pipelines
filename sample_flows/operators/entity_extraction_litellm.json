{
  "flow_name": "LiteLLM Entity Extraction and Translation",
  "description": "Classify documents, extract entities, and translate document text into French using LiteLLM",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_source",
      "config": {
        "provider": "filesystem",
        "provider_config": {
          "paths": [
            "./tests/fixtures/invoices"
          ]
        },
        "include_filter": "pdf,docx,txt"
      }
    },
    {
      "name": "classify",
      "type": "document_classifier",
      "config": {
        "provider": "litellm",
        "provider_config": {
          "model_id": "openai/granite4:latest",
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        },
        "confidence_threshold": 7.0,
        "doc_column": "content",
        "output_column": "document_type",
        "include_confidence": true,
        "include_reasoning": false,
        "max_content_length": 8000
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        },
        "entity_extraction": {
          "provider": "litellm",
          "provider_config": {
            "model_id": "openai/granite4:latest",
            "temperature": 0.0,
            "max_tokens": 2000,
            "api_base": "http://localhost:11434/v1",
            "api_key": "<ollama_key>"
          },
          "max_doc_chars": 8000,
          "expand_extracted_data": false
        },
        "max_workers": 2
      },
      "depends_on": [
        "classify"
      ]
    },
    {
      "name": "translate",
      "type": "translation",
      "config": {
        "provider": "litellm",
        "provider_config": {
          "model_id": "openai/granite4:latest",
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        },
        "doc_column": "content",
        "output_column": "translated_content",
        "source_language": "auto",
        "target_language": "French",
        "preserve_markdown": true,
        "max_input_tokens": 4096
      },
      "depends_on": [
        "extract"
      ]
    }
  ]
}
