{
  "flow_name": "invoice processing flow",
  "description": "a flow to demonstrate invoice processing with docpipe pipeline",
  "global_config": {
    "doc_column": "content",
    "disable_validation": true,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_source",
      "config": {
        "provider": "filesystem",
        "provider_config": {
          "paths": [
            "tests/fixtures/invoices"
          ]
        },
        "include_filter": ".pdf",
        "max_workers": 2
      }
    },
    {
      "name": "classify",
      "type": "document_classifier",
      "config": {
        "provider": "litellm",
        "provider_config": {
          "model_id": "openai/llama3.2",
          "api_key": "${OLLAMA_API_KEY}",
          "api_base": "http://localhost:11434/v1",
          "temperature": 0.0,
          "max_tokens": 1000
        },
        "confidence_threshold": 7.0,
        "doc_column": "content",
        "output_column": "document_type",
        "include_confidence": true,
        "include_reasoning": true,
        "max_content_length": 8000
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        },
        "entity_extraction": {
          "provider": "docling"
        }
      },
      "depends_on": [
        "classify"
      ]
    },
    {
      "name": "chunk",
      "type": "chunker",
      "config": {
        "chunk_type": "hybrid",
        "doc_column": "content",
        "chunk_size": 512,
        "chunk_overlap": 128,
        "retain_original_content": false
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "provider": "litellm",
        "embeddings_column": "embeddings",
        "doc_column": "content",
        "provider_config": {
          "model_id": "openai/nomic-embed-text",
          "api_base": "http://localhost:11434/v1",
          "api_key": "<ollama>"
        }
      },
      "depends_on": [
        "chunk"
      ]
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "config": {
        "provider": "opensearch",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 768,
        "provider_config": {
          "index_name": "invoices_test",
          "host": "localhost",
          "port": 9200,
          "username": "${OPENSEARCH_USERNAME}",
          "password": "${OPENSEARCH_PASSWORD}",
          "use_ssl": false,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "feature_mappings": [
          {
            "feature_name": "doc_id_hash",
            "mapped_column_name": "pk"
          },
          {
            "feature_name": "content",
            "mapped_column_name": "text"
          },
          {
            "feature_name": "embeddings",
            "mapped_column_name": "vector_embeddings"
          },
          {
            "feature_name": "extracted_invoice_number",
            "mapped_column_name": "invoice_number"
          },
          {
            "feature_name": "extracted_invoice_date",
            "mapped_column_name": "invoice_date"
          },
          {
            "feature_name": "extracted_vendor_name",
            "mapped_column_name": "vendor_name"
          },
          {
            "feature_name": "extracted_grand_total",
            "mapped_column_name": "grand_total"
          }
        ]
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}
