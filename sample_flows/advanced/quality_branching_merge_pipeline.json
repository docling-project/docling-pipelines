{
  "flow_name": "Branching and Merging Pipeline",
  "description": "Demonstrates both BranchingOperator and MergeOperator: Ingest \u2192 Extract \u2192 Language Detection \u2192 Dedup \u2192 Doc Quality \u2192 Readability \u2192 Branch (3-way split on word count) \u2192 [Long Docs: ML Enrichment] | [Medium Docs: SQL Filter] | [Short Docs: Noop] \u2192 Merge (rows) \u2192 Embeddings \u2192 OpenSearch. Shows document-length-based conditional routing with 3 branches and row-based merging.",
  "global_config": {
    "doc_column": "content",
    "disable_validation": false,
    "force_ingest": true,
    "storage": "in-memory",
    "execute_type": "local"
  },
  "flow": [
    {
      "name": "ingest",
      "type": "ingest_source",
      "config": {
        "provider": "filesystem",
        "provider_config": {
          "paths": [
            "tests/fixtures/customer_support_docs/"
          ]
        },
        "include_filter": "txt,pdf"
      }
    },
    {
      "name": "extract",
      "type": "extract_operator",
      "config": {
        "text_extraction": {
          "provider": "docling_library",
          "doc_column": "content"
        },
        "entity_extraction": {
          "provider": "none"
        }
      },
      "depends_on": [
        "ingest"
      ]
    },
    {
      "name": "detect_language",
      "type": "lang_detect",
      "config": {
        "doc_column": "content"
      },
      "depends_on": [
        "extract"
      ]
    },
    {
      "name": "dedup",
      "type": "ededup",
      "config": {
        "doc_column": "content",
        "doc_id_column": "doc_id_hash"
      },
      "depends_on": [
        "detect_language"
      ]
    },
    {
      "name": "doc_quality",
      "type": "doc_quality",
      "config": {
        "doc_column": "content",
        "doc_content_column": "content",
        "text_lang": "en"
      },
      "depends_on": [
        "dedup"
      ]
    },
    {
      "name": "readability",
      "type": "readability",
      "config": {
        "doc_column": "content",
        "readability_score_list": [
          "flesch_reading_ease",
          "flesch_kincaid_grade",
          "gunning_fog",
          "difficult_words",
          "dale_chall_readability_score"
        ]
      },
      "depends_on": [
        "doc_quality"
      ]
    },
    {
      "name": "quality_branching",
      "type": "branching",
      "config": {
        "branches": {
          "long_docs_branch": {
            "link_name": "Long Documents",
            "criteria_json": {
              "criteria_list": [
                {
                  "variable": "docq_total_words",
                  "operator": ">=",
                  "value": 98
                }
              ],
              "logical_operator": "AND"
            }
          },
          "medium_docs_branch": {
            "link_name": "Medium Documents",
            "criteria_json": {
              "criteria_list": [
                {
                  "variable": "docq_total_words",
                  "operator": ">=",
                  "value": 78
                },
                {
                  "variable": "docq_total_words",
                  "operator": "<",
                  "value": 98
                }
              ],
              "logical_operator": "AND"
            }
          },
          "short_docs_branch": {
            "link_name": "Short Documents",
            "criteria_json": {
              "criteria_list": [
                {
                  "variable": "docq_total_words",
                  "operator": "<",
                  "value": 78
                }
              ],
              "logical_operator": "AND"
            }
          }
        }
      },
      "depends_on": [
        "readability"
      ]
    },
    {
      "name": "ml_enrichment_long",
      "type": "ml_enrichment",
      "config": {
        "doc_column": "content",
        "lang_column": "lang_name",
        "output_column_prefix": "ml_long_",
        "error_column_name": "enrichment_error_long"
      },
      "depends_on": [
        "quality_branching.long_docs_branch"
      ]
    },
    {
      "name": "sql_filter_medium",
      "type": "sql_filter",
      "config": {
        "criteria_json": {
          "criteria_list": [
            {
              "variable": "flesch_reading_ease",
              "operator": ">",
              "value": 0
            }
          ],
          "logical_operator": "AND"
        }
      },
      "depends_on": [
        "quality_branching.medium_docs_branch"
      ]
    },
    {
      "name": "noop_short",
      "type": "noop",
      "config": {},
      "depends_on": [
        "quality_branching.short_docs_branch"
      ]
    },
    {
      "name": "merge_all_branches",
      "type": "merge",
      "config": {
        "merge_type": "rows",
        "input_links": [
          {
            "link_name": "long_docs_processed"
          },
          {
            "link_name": "medium_docs_processed"
          },
          {
            "link_name": "short_docs_processed"
          }
        ]
      },
      "depends_on": [
        "ml_enrichment_long",
        "sql_filter_medium",
        "noop_short"
      ]
    },
    {
      "name": "embeddings",
      "type": "embeddings",
      "config": {
        "provider": "litellm",
        "embeddings_column": "embeddings",
        "overlap_ratio": 0.2,
        "doc_column": "content",
        "provider_config": {
          "model_id": "openai/granite4:latest",
          "api_base": "http://localhost:11434/v1",
          "api_key": "${OLLAMA_API_KEY}"
        }
      },
      "depends_on": [
        "merge_all_branches"
      ]
    },
    {
      "name": "vectordb",
      "type": "vectordb",
      "config": {
        "provider": "opensearch",
        "doc_id_column": "doc_id_hash",
        "embeddings_column": "embeddings",
        "vector_dimension": 2560,
        "provider_config": {
          "index_name": "branched_merged_docs",
          "host": "localhost",
          "port": 9200,
          "username": "${OPENSEARCH_USERNAME}",
          "password": "${OPENSEARCH_PASSWORD}",
          "use_ssl": false,
          "verify_certs": false,
          "batch_size": 100,
          "engine": "faiss",
          "algorithm": "hnsw",
          "space_type": "l2"
        },
        "feature_mappings": [
          {
            "feature_name": "doc_id_hash",
            "mapped_column_name": "pk"
          },
          {
            "feature_name": "name",
            "mapped_column_name": "doc_name"
          },
          {
            "feature_name": "content",
            "mapped_column_name": "text"
          },
          {
            "feature_name": "embeddings",
            "mapped_column_name": "vector_embeddings"
          },
          {
            "feature_name": "lang_name",
            "mapped_column_name": "language"
          },
          {
            "feature_name": "flesch_reading_ease",
            "mapped_column_name": "readability_score"
          },
          {
            "feature_name": "flesch_kincaid_grade",
            "mapped_column_name": "grade_level"
          },
          {
            "feature_name": "gunning_fog",
            "mapped_column_name": "fog_index"
          },
          {
            "feature_name": "docq_total_words",
            "mapped_column_name": "word_count"
          }
        ]
      },
      "depends_on": [
        "embeddings"
      ]
    }
  ]
}
